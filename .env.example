# Бот: @BotFather → /newbot
BOT_TOKEN=123456:ABC...
# Твой user id (ты — админ: приглашаешь других) — узнать у @userinfobot
OWNER_ID=123456789
# Ключ шифрования cookie СДО в базе. Сгенерировать:
#   uv run python -c "from study_bot.vault import new_key; print(new_key())"
# Потеряешь или сменишь — всем придётся заново прислать /cookie
COOKIE_KEY=
# Только если Telegram с этой машины недоступен (сервер в России): прокси для запросов к Telegram
TELEGRAM_PROXY=

# Необязательно: группы, которые бот читает сам, если его туда добавят (id бот пришлёт при добавлении)
CHAT_IDS=[]
# id старосты/преподавателя — их длинные сообщения в группе проверяются даже без ключевых слов
TRUSTED_SENDERS=[]

# Необязательно. Пусто — бесплатный разбор правилами.
# С ключом (https://platform.claude.com → API Keys) задания разбирает Claude — точнее, но платно
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Свои сокращения предметов для разбора правилами (названия курсов с портала подхватываются сами)
SUBJECT_ALIASES={"ос": "Операционные системы", "бд": "Базы данных для индустриальных задач"}

TZ=Europe/Moscow
DIGEST_HOUR=20
DIGEST_MINUTE=0
# Опрос портала заодно держит сессию Moodle живой
PORTAL_POLL_MINUTES=30
NOTIFY_NEW=true

# СДО МИРЭА (Moodle). none — отключить портал
PORTAL_KIND=moodle
PORTAL_URL=https://online-edu.mirea.ru
# Cookie сессии не здесь: пришли её боту командой /cookie (хранится в data/moodle_session.txt)
PORTAL_LOOKBACK_DAYS=60

# Mini App. Публичный https-адрес (например https://studybot.duckdns.org) — без него кнопок «Открыть» нет
WEBAPP_URL=
WEBAPP_PORT=8080
# Только для локальной разработки в обычном браузере (http://127.0.0.1:8080): API без проверки Telegram
WEBAPP_DEV_NO_AUTH=false
