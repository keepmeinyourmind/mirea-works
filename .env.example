# Telegram userbot: https://my.telegram.org → API development tools
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef
# id супергрупп (печатает `uv run python -m study_bot.login`)
CHAT_IDS=[-1001234567890]
# id старосты/преподавателя — их длинные сообщения проверяются даже без ключевых слов
TRUSTED_SENDERS=[]
BACKFILL_DAYS=14

# Бот для уведомлений: @BotFather → /newbot
BOT_TOKEN=123456:ABC...
# твой user id (тоже печатает login)
OWNER_ID=123456789

# https://platform.claude.com → API keys
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-5-5

TZ=Europe/Moscow
DIGEST_HOUR=20
DIGEST_MINUTE=0
# Опрос портала заодно держит сессию Moodle живой
PORTAL_POLL_MINUTES=30
NOTIFY_NEW=true

# СДО МИРЭА (Moodle). none — отключить портал
PORTAL_KIND=moodle
PORTAL_URL=https://online-edu.mirea.ru
# Cookie сессии не здесь: пришли её боту командой /cookie (хранится в data/moodle_session.txt)
PORTAL_LOOKBACK_DAYS=60
